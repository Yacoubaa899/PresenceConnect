# Copie ce fichier en ".env" et remplis tes vraies valeurs.
# Ne jamais mettre le vrai .env sur GitHub.

PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=presenceconnect

# Clé secrète utilisée pour signer les tokens de connexion.
# Génère une vraie valeur aléatoire longue avant la mise en production.
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d